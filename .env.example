# Copy to .env and fill in. Generate a key with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Optional: host port for Open WebUI (default 3000)
# OPEN_WEBUI_PORT=3000
# For sync_webui.py: Open WebUI -> Settings -> Account -> API Keys
OPEN_WEBUI_API_KEY=
# Optional: Open WebUI URL for sync_webui.py (default http://localhost:$OPEN_WEBUI_PORT)
# OPEN_WEBUI_URL=http://localhost:3000
